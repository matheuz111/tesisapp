rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOperator() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['OPERATOR', 'ADMIN'];
    }

    function isParticipant(requestData) {
      return signedIn()
        && (requestData.get('clientId', '') == request.auth.uid || requestData.get('providerId', '') == request.auth.uid);
    }

    match /users/{userId} {
      // Los perfiles son consultables para asignación, historial y contacto.
      allow read: if signedIn();

      // Los roles privilegiados nunca se crean desde la aplicación pública.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['CLIENT', 'PROVIDER'];

      // Cada persona mantiene su perfil sin poder cambiar rol ni aprobación.
      allow update: if isOperator()
        || (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('is_verified', false) == resource.data.get('is_verified', false)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price_range', 'activeRequestId', 'approval_status', 'approvedBy', 'approvedAt']))
        // Compatibilidad: el cliente puede acumular la calificación del técnico.
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['total_rating', 'review_count', 'jobs_completed']));
    }

    match /push_tokens/{userId} {
      // El propietario y el operador pueden leer el token para asignación de notificaciones
      allow read: if signedIn() && (request.auth.uid == userId || isOperator()
        || get(/databases/$(database)/documents/users/$(userId)).data.role in ['OPERATOR', 'ADMIN']);
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /counters/{counterId} {
      // Generación correlativa atómica para códigos de atención SOL-POST-XXXX
      allow read, write: if signedIn();
    }

    match /service_requests/{requestId} {
      // Creación: operador o cliente. El cliente no puede inyectar el token del técnico
      allow create: if isOperator()
        || (signedIn() 
            && request.resource.data.clientId == request.auth.uid
            && request.resource.data.status == 'PENDING_ASSIGNMENT'
            && request.resource.data.get('providerId', null) == null
            && !request.resource.data.keys().hasAny(['pricing', 'assignedBy'])
            && (!('notificationTokens' in request.resource.data) 
                || !('provider' in request.resource.data.notificationTokens)));

      allow read: if isOperator() || isParticipant(resource.data);

      // Actualización: operador o participantes con restricciones de tokens y asignación
      function validPricingChange() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['pricing', 'price_agreed']) || (
          resource.data.status in ['PENDING_ASSIGNMENT', 'REQUIRES_REASSIGNMENT', 'PENDING', 'QUOTED']
          && request.resource.data.pricing.amountCents is int
          && request.resource.data.pricing.amountCents > 0
          && request.resource.data.pricing.amountCents <= 9999999
          && request.resource.data.pricing.currency == 'PEN'
          && request.resource.data.pricing.description is string
          && request.resource.data.pricing.description.size() > 0
          && request.resource.data.pricing.description.size() <= 300
          && request.resource.data.pricing.assignedBy == request.auth.uid
          && request.resource.data.pricing.updatedAt == request.time
          && request.resource.data.pricing.version == resource.data.get('pricing', {}).get('version', 0) + 1
          && request.resource.data.price_agreed is string
        );
      }
      function ownTokensOnly() {
        let before = resource.data.get('notificationTokens', {});
        let after = request.resource.data.get('notificationTokens', {});
        return (request.auth.uid == resource.data.clientId && after.diff(before).affectedKeys().hasOnly(['client']))
          || (request.auth.uid == resource.data.get('providerId', '') && after.diff(before).affectedKeys().hasOnly(['provider']));
      }
      function validParticipantTransition() {
        let before = resource.data.status;
        let after = request.resource.data.status;
        return before == after || (
          request.auth.uid == resource.data.clientId
            ? (before in ['PENDING_ASSIGNMENT', 'REQUIRES_REASSIGNMENT', 'PENDING', 'ACCEPTED', 'QUOTED'] && after == 'CANCELLED_BY_CLIENT')
              || (before == 'QUOTED' && after == 'PENDING_ASSIGNMENT')
            : (before == 'PENDING' && after in ['ACCEPTED', 'REQUIRES_REASSIGNMENT'])
              || (before == 'ACCEPTED' && after in ['IN_PROGRESS', 'REQUIRES_REASSIGNMENT'])
              || (before == 'IN_PROGRESS' && after in ['COMPLETED', 'REQUIRES_REASSIGNMENT'])
        );
      }
      function timestampsNotModified() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (!('createdAt' in resource.data) || !changed.hasAny(['createdAt']))
          && (!('startedAt' in resource.data) || !changed.hasAny(['startedAt']))
          && (!('finishedAt' in resource.data) || !changed.hasAny(['finishedAt']));
      }
      allow update: if (isOperator() && validPricingChange())
        || (isParticipant(resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['clientId', 'providerId', 'organizationId', 'assignedBy', 'pricing', 'price_agreed', 'location', 'address', 'addressReference', 'district', 'securityPin'])
          && ownTokensOnly()
          && validParticipantTransition()
          && timestampsNotModified());

      // Subcolección inmutable de auditoría científica para IBM SPSS
      match /status_history/{historyId} {
        allow read: if isOperator() || isParticipant(get(/databases/$(database)/documents/service_requests/$(requestId)).data);
        allow create: if signedIn();
        allow update, delete: if false; // Inmutable ante el jurado
      }

      match /price_history/{revisionId} {
        allow read: if isOperator() || isParticipant(get(/databases/$(database)/documents/service_requests/$(requestId)).data);
        allow create: if isOperator()
          && request.resource.data == getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.pricing;
        allow update, delete: if false;
      }

      match /locations/{userId} {
        function serviceData() {
          return get(/databases/$(database)/documents/service_requests/$(requestId)).data;
        }
        allow read: if isOperator() || (signedIn() && request.auth.uid == userId && isParticipant(serviceData()));
        allow create, update: if signedIn() && request.auth.uid == userId
          && isParticipant(serviceData())
          && serviceData().status in ['PENDING_ASSIGNMENT', 'REQUIRES_REASSIGNMENT', 'PENDING', 'ACCEPTED', 'IN_PROGRESS']
          && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'accuracy', 'capturedAt', 'updatedAt'])
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
          && (request.resource.data.accuracy == null || (request.resource.data.accuracy is number && request.resource.data.accuracy >= 0))
          && request.resource.data.capturedAt is number
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read, create: if isOperator()
          || isParticipant(get(/databases/$(database)/documents/service_requests/$(requestId)).data);
        allow update, delete: if false;
      }
    }

    // Presencia operativa en tiempo real para mapa y despacho (Fase 2)
    match /provider_presence/{providerId} {
      function isProvider() {
        return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'PROVIDER';
      }

      function validPresencePayload() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'providerId', 'providerName', 'providerPhone', 'status',
            'location', 'geohash', 'accuracy', 'lastSeenAt',
            'specialties', 'zones', 'activeRequestId', 'batteryLevel',
            'district', 'updatedAt'
          ])
          && data.providerId == providerId
          && data.status in ['AVAILABLE', 'BUSY', 'OFFLINE']
          && data.location.keys().hasOnly(['latitude', 'longitude'])
          && data.location.latitude is number
          && data.location.latitude >= -90 && data.location.latitude <= 90
          && data.location.longitude is number
          && data.location.longitude >= -180 && data.location.longitude <= 180
          && data.geohash is string
          && data.geohash.size() > 0 && data.geohash.size() <= 12
          && (data.accuracy == null || (data.accuracy is number && data.accuracy >= 0))
          && data.updatedAt == request.time
          && data.lastSeenAt == request.time
          && (!('batteryLevel' in data) || data.batteryLevel == null || (data.batteryLevel is number && data.batteryLevel >= 0 && data.batteryLevel <= 100))
          && (!('specialties' in data) || data.specialties is list)
          && (!('zones' in data) || data.zones is list);
      }

      allow read: if isOperator() || (signedIn() && request.auth.uid == providerId);
      allow create, update: if isProvider()
        && request.auth.uid == providerId
        && validPresencePayload();
      allow delete: if isOperator() || (signedIn() && request.auth.uid == providerId);
    }

    // Certificados de garantía verificables (QR). Cualquiera puede LEER un documento si conoce su código
    // aleatorio de 16 caracteres, pero nadie puede listar la colección: el código no se puede recorrer.
    // El documento público no incluye datos personales completos. Solo la central emite y anula.
    match /warranty_certificates/{certId} {
      function validNewCertificate(data) {
        return certId.matches('^[A-HJKMNP-TV-Z2-9]{16}$')
          && data.keys().hasOnly(['code', 'requestId', 'serviceLabel', 'clientMasked', 'issuedAt', 'validFrom', 'validUntil', 'status', 'issuedBy'])
          && data.keys().hasAll(['code', 'requestId', 'serviceLabel', 'clientMasked', 'issuedAt', 'validFrom', 'validUntil', 'status', 'issuedBy'])
          && data.code == certId
          && data.requestId is string && data.requestId.size() > 0 && data.requestId.size() <= 64
          && data.serviceLabel is string && data.serviceLabel.size() <= 80
          && data.clientMasked is string && data.clientMasked.size() <= 80
          && data.status == 'ACTIVE'
          && data.issuedAt == request.time
          && data.issuedBy == request.auth.uid
          && data.validFrom is timestamp
          && data.validUntil is timestamp
          && data.validUntil == data.validFrom + duration.value(30, 'd');
      }

      allow get: if true;
      allow list: if isOperator();
      allow create: if isOperator() && validNewCertificate(request.resource.data);
      // La única modificación posible es anular, una sola vez y sin tocar ningún otro dato.
      allow update: if isOperator()
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'REVOKED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'revokedBy'])
        && request.resource.data.revokedAt == request.time
        && request.resource.data.revokedBy == request.auth.uid;
      allow delete: if false;

      // Motivo de la anulación: solo para la central, nunca público.
      match /admin/{adminDocId} {
        allow read: if isOperator();
        allow create: if isOperator()
          && adminDocId == 'revocation'
          && request.resource.data.keys().hasOnly(['reason', 'revokedAt', 'revokedBy'])
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 300
          && request.resource.data.revokedAt == request.time
          && request.resource.data.revokedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Registro de escaneos del QR. Un documento por certificado y día (el id lo impone la regla), así que
    // nadie puede inflar las escrituras: máximo (certificados × días). Solo la central lo lee.
    // Retención de 12 meses: cada registro trae expireAt. La central limpia los vencidos desde el panel
    // (no se usa TTL de Firestore porque exige facturación). Solo se pueden borrar registros ya vencidos.
    match /warranty_scans/{scanId} {
      allow read: if isOperator();
      allow create: if request.resource.data.keys().hasOnly(['certificateId', 'at', 'expireAt'])
        && request.resource.data.certificateId is string
        && request.resource.data.certificateId.matches('^[A-HJKMNP-TV-Z2-9]{16}$')
        && exists(/databases/$(database)/documents/warranty_certificates/$(request.resource.data.certificateId))
        && scanId == request.resource.data.certificateId + '_' + string(request.time.year() * 10000 + request.time.month() * 100 + request.time.day())
        && request.resource.data.at == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time + duration.value(364, 'd')
        && request.resource.data.expireAt < request.time + duration.value(366, 'd');
      allow update: if false;
      allow delete: if isOperator() && resource.data.expireAt < request.time;
    }

    // Colección heredada: se conserva para no romper conversaciones antiguas.
    match /chats/{chatId} {
      allow read, write: if signedIn();
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }
  }
}
