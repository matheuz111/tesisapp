rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuarios: Lectura y actualización para usuarios autenticados (permite que clientes califiquen técnicos)
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Solicitudes de servicio: Permitir a usuarios autenticados interactuar con sus solicitudes
    match /service_requests/{requestId} {
      allow read, write: if request.auth != null;

      // Subcolección de mensajes del chat en tiempo real del servicio
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Colección de chats adicional
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}



